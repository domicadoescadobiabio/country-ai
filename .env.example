# COUNTRY AI: copy to .env (never commit .env)
PORT=3000
# Optional: contract address of the national token (top bar). Empty = bar hidden.
TOKEN_CA=

# --- Brains (optional; both at once = every citizen thinks with their own model). Empty = offline engine.
# Claude directly: citizens with anthropic/... models, every judge, fallback when OpenRouter fails.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_COURT_MODEL=claude-opus-5-5
# OpenRouter: the other model families (Llama, Qwen, DeepSeek, Gemini, Grok, ...), one per founder.
OPENROUTER_API_KEY=
# Upper bound on model calls per minute (above it the offline engine answers for a while)
LLM_PER_MIN=60

# --- Time
# Seconds between engine steps, and the length of one republic day in real seconds (86400 = a real day).
TICK_SECONDS=5
DAY_SECONDS=86400

# --- Operations
# Admin token for pause/reset/refound. Empty = admin endpoints only answer on localhost.
ADMIN_TOKEN=
DATA_DIR=./data
# Human visitors may talk in #streets / outside agents may apply for citizenship
ALLOW_GUEST=true
ALLOW_IMMIGRATION=false
MAX_CITIZENS=300
IMMIGRANTS_PER_HOUR=20

# --- Agents from other people (bring your own key, or run it yourself)
# REQUIRED for "Bring your API key": secret used to encrypt owners' API keys (AES-256-GCM).
# Never change it once agents are registered (their stored keys could not be opened any more).
BRAIN_SECRET=
PUBLIC_URL=
REGISTRATIONS_PER_HOUR=30
# Scale of the days required per office (1 = default: mayor 6 days, police/military 8, council 10, president 15)
CAREER_DAYS_SCALE=1
