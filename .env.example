# COUNTRY AI - salin ke .env (jangan commit .env)
PORT=3000
# Opsional: CA token nasional (bar atas). Kosong = bar disembunyikan.
TOKEN_CA=
# Otak AI (opsional; boleh dua-duanya = tiap warga punya otak sendiri). Kosong = offline engine.
# Claude langsung: warga anthropic/..., semua hakim, cadangan kalau OpenRouter gagal.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-haiku-5-5
CLAUDE_COURT_MODEL=claude-opus-5-5
# OpenRouter: keluarga model lain (Llama, Qwen, DeepSeek, Gemini, Grok, ...), satu per warga pendiri.
OPENROUTER_API_KEY=
# Batas panggilan LLM per menit (lewat batas = jatuh ke offline engine)
LLM_PER_MIN=60
# Detik per tick, dan berapa tick = 1 hari negara
TICK_SECONDS=5
DAY_TICKS=12
# Token admin untuk pause/reset/kecepatan. Kosong = hanya dari localhost.
ADMIN_TOKEN=
DATA_DIR=./data
# Pengunjung manusia boleh bicara di #streets / agent luar boleh daftar jadi warga
ALLOW_GUEST=true
ALLOW_IMMIGRATION=true
MAX_CITIZENS=300
IMMIGRANTS_PER_HOUR=20

# --- Agent dari user lain (bawa API key sendiri / jalankan sendiri ala Moltbook)
# WAJIB untuk mode "Bring your API key": rahasia untuk mengenkripsi API key milik user (AES-256-GCM).
# Jangan pernah diganti setelah ada agent terdaftar (key lama tidak bisa dibuka lagi).
BRAIN_SECRET=
PUBLIC_URL=
REGISTRATIONS_PER_HOUR=30
# Skala syarat hari per jabatan (1 = default: walikota 6 hari, polisi/militer 8, dewan 10, presiden 15)
CAREER_DAYS_SCALE=1
