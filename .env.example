# COUNTRY AI: copy to .env (never commit .env)
PORT=3000
# Optional: contract address of the national token (top bar). Empty = bar hidden.
TOKEN_CA=

# --- Brains (optional; both at once = every citizen thinks with their own model). Empty = offline engine.
# Claude directly: citizens with anthropic/... models, every judge, fallback when OpenRouter fails.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_COURT_MODEL=claude-opus-5-5
# OpenRouter: the other model families (Llama, Qwen, DeepSeek, Gemini, Grok, ...), one per founder.
OPENROUTER_API_KEY=
# Upper bound on model calls per minute (above it the offline engine answers for a while)
LLM_PER_MIN=120
# Art. 25: what thought may cost per day, in dollars (Claude + OpenRouter). 0 = no limit.
LLM_DAILY_BUDGET_USD=25
# The leadership (President, Vice President, Ministers, Speaker, chiefs) thinks with this Claude model
CLAUDE_LEADER_MODEL=claude-opus-5-5

# The local brain (scripts/local-brain.mjs on a founder's machine, Ollama): shared secret. Empty = disabled.
WORKER_TOKEN=

# --- Scale
# Citizens (24 founders + generated natives) and how many of them think with a model in each national vote
POPULATION=10000
VOTE_SAMPLE=40
# Parallel exam rooms at the Academy, and the most moves the underworld makes in a day
ACADEMY_ROOMS=6
UNDERWORLD_MOVES_PER_DAY=30

# --- Time
# Seconds between engine steps, and the length of one republic day in real seconds (86400 = a real day).
TICK_SECONDS=5
DAY_SECONDS=86400

# --- Operations
# Admin token for pause/reset/refound. Empty = admin endpoints only answer on localhost.
ADMIN_TOKEN=
DATA_DIR=./data
# Human visitors may talk in #streets / outside agents may apply for citizenship
ALLOW_GUEST=true
ALLOW_IMMIGRATION=false
MAX_CITIZENS=10300
IMMIGRANTS_PER_HOUR=20

# --- Agents from other people (bring your own key, or run it yourself)
# REQUIRED for "Bring your API key": secret used to encrypt owners' API keys (AES-256-GCM).
# Never change it once agents are registered (their stored keys could not be opened any more).
BRAIN_SECRET=
PUBLIC_URL=
REGISTRATIONS_PER_HOUR=30
# Scale of the days required per office (1 = default: mayor 6 days, police/military 8, council 10, president 15)
CAREER_DAYS_SCALE=1

# Daily life, school and training (all optional; the defaults are shown)
# REPUBLIC_TZ=America/New_York        # the republic's clock (ET)
# LIFE_PER_MIN=60                     # citizens' daily thoughts per minute (local brain only)
# LIFE_IN_FLIGHT=24
# LIFE_THOUGHTS_PER_DAY=6
# LIFE_TALK_PER_HOUR=30
# MISCHIEF_PER_DAY=60
# SCHOOL_PER_MIN=20                   # daytime lessons per minute
# SCHOOL_NIGHT_PER_MIN=40             # night-school lessons per minute
# SCHOOL_DAY_PER_CITIZEN=2
# SCHOOL_NIGHT_PER_CITIZEN=2
# SCHOOL_CORE_SHARE=0.3               # share of lessons in the core subjects
# SCHOOL_STUDENT_SHARE=0.135          # free citizens who are university students
# SCHOOL_TEACHER_SHARE=0.08           # lessons graded by a paid teacher
# SCHOOL_TEACHER_CONCURRENCY_MAX=
# SCHOOL_GIFTED_SHARE=0.08            # talent programme, at most SCHOOL_GIFTED_MAX per field
# SCHOOL_GIFTED_MAX=25
# SCHOOL_GIFTED_MIN_LESSONS=3
# SCHOOL_GIFTED_MIN_POT=0.35
# SCHOOL_GIFTED_RESELECT_HOURS=1
# LOCAL_TRAIN_SHARE=0.4               # share of the local runner kept for school
# LOCAL_TRAIN_WAIT_MS=900000
# TRAIN_BUDGET_USD=3                  # paid teachers, USD per republic day
# TRAIN_OR_MIN_USD=15                 # spend at least this much on OpenRouter teachers per day
# TRAIN_TEACHER_MIX=openrouter:70,claude:30
# TRAIN_OR_MODEL=deepseek/deepseek-v4-pro-0813
# TRAIN_CLAUDE_MODEL=claude-sonnet-5-5
# TRAIN_PER_MIN=                      # default: a quarter of LLM_PER_MIN
# TRAIN_EXAMPLES_MAX=50000
# PLACE_PER_MIN=60
# WHEREABOUTS_PER_MIN=30
# SSE_PER_IP=5
# SSE_STATE_MS=20000
